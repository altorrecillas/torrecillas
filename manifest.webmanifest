{
  "name": "Torrecillas OS",
  "short_name": "Torrecillas OS",
  "lang": "es",
  "description": "Un escritorio estilo Windows XP en tu navegador: 16 juegos clasicos, Paint, terminal y portfolio.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#08286c",
  "theme_color": "#1941a5",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Tareas",
      "short_name": "Tareas",
      "description": "Lo que hay que hacer hoy",
      "url": "./?app=tareas",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Lista de la compra",
      "short_name": "Compra",
      "description": "Anadir productos a la lista",
      "url": "./?app=compra",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Apuntar un gasto",
      "short_name": "Gastos",
      "description": "Control de gastos del mes",
      "url": "./?app=gastos",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Notas",
      "short_name": "Notas",
      "description": "Cuaderno de notas",
      "url": "./?app=notas",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "application/epub+zip",
            "application/pdf",
            ".epub",
            ".pdf"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
